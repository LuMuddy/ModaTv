# 复制为 local.properties（该文件已被 .gitignore 排除）后填入真实值。
# local.properties 同时需要 sdk.dir，例如：
#   sdk.dir=/path/to/Android/sdk
#
# 构建时这些键会被注入为 BuildConfig 字段，代码里不保存任何真实值。

# 代理后端地址，对应 BuildConfig.API_BASE（留空则应用启动后直接报请求失败）
modatv.apiBase=

# 设备令牌与指纹，对应 BuildConfig.DEVICE_TOKEN / BuildConfig.DEVICE_FP
modatv.deviceToken=
modatv.deviceFp=

# 腾讯热词接口凭据，对应 BuildConfig.HOT_WORDS_APP_ID / BuildConfig.HOT_WORDS_APP_KEY
modatv.hotWordsAppId=
modatv.hotWordsAppKey=
