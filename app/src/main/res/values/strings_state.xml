<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== 状态层（TvViewModel）上屏文案 ====================
         只放「会显示在屏幕上」的句子；日志与内部异常文本不翻译（排错时中文更好认）。
         键名两侧（values / values-en）必须完全一致，参数用 %1$d / %1$s 占位。 -->

    <!-- 整页刷新提示（HomeRefreshNotice.messageRes） -->
    <string name="state_refresh_done">刷新完成</string>
    <string name="state_refresh_failed_kept">刷新失败，已保留原有内容</string>

    <!-- 集数标签兜底：元数据缺失时 label 会退化成 vid，只能自己拼一句 -->
    <string name="state_episode_index">第 %1$d 集</string>

    <!-- 授权码兑换失败（TvViewModel.authorize 的返回值）。它会上屏到授权门与设置页两处，
         所以必须是完整的人话，不能是错误码。 -->
    <string name="settings_auth_code_required">请输入授权码</string>
    <string name="settings_auth_failed">授权失败，请稍后重试</string>
</resources>
