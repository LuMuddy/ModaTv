    <!-- ==================== 授权门（未授权时整屏只有这一张卡，见 ui/AuthGateScreen.kt） ==================== -->
    <string name="gate_title">需要授权</string>
    <!-- 主路径是扫码；授权码只在扫码之后或扫码不可用时补位，所以这句话把它留在后半句 -->
    <string name="gate_message">用微信扫描下方二维码并确认登录。登录一次长期有效，不授权将退出应用。</string>
    <!-- 状态行：取码中 / pending / 取码失败 / 已扫码 / 过期 / 账号未激活 -->
    <string name="gate_qr_loading">正在获取登录二维码…</string>
    <string name="gate_qr_hint">请用微信扫一扫</string>
    <string name="gate_scanned">已扫码，请在手机上点「确认登录」</string>
    <string name="gate_expired">二维码已过期，请点「刷新二维码」</string>
    <string name="gate_qr_failed">二维码获取失败，请点「刷新二维码」</string>
    <string name="gate_need_code">账号未激活，请输入授权码</string>
    <!-- 授权码补位：输入区说明、没有扫码会话时的指引、占位、闸门、按钮 -->
    <string name="gate_code_hint">输入管理员提供的一次性授权码，再点「激活」</string>
    <string name="gate_code_placeholder">请输入 8 位授权码</string>
    <string name="gate_code_invalid">授权码是 8 位字母或数字</string>
    <!-- 只剩 TvViewModel.activate 的空 token 守卫在用（入口唯一化之后本屏走不到这里）；
         要连它一起删，必须同时删 TvViewModel 里那一行守卫——那个文件不在本轮的改动边界内 -->
    <string name="gate_code_need_scan">请先点「刷新二维码」重新扫码：授权码要在扫码之后使用</string>
    <string name="gate_activate">激活</string>
    <string name="gate_activating">正在激活…</string>
    <string name="gate_refresh_qr">刷新二维码</string>
    <string name="gate_exit">退出</string>
