<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== 版本更新（ui/UpdateDialog.kt + 关于子页的「检查更新」行） ====================
         只放会显示在屏幕上的句子；ViewModel 里只有中文日志，没有中文字面量上屏。
         参数一律 %1$s / %1$d；下载百分比里的 % 必须写成 %% ，否则格式化时会吃掉。 -->

    <!-- 「关于」子页那一行 -->
    <string name="update_row_title">检查更新</string>
    <!-- 手动检查失败后用它邀请重试：比「已是最新」更诚实，用户刚点过这一行 -->
    <string name="update_row_idle">点按检查</string>
    <string name="update_checking">检查中…</string>
    <string name="update_row_latest">已是最新</string>
    <string name="update_row_found">发现 v%1$s</string>

    <!-- 弹窗 -->
    <string name="update_title">发现新版本 v%1$s</string>
    <string name="update_notes_header">更新内容</string>
    <string name="update_notes_empty">这一版没有填写更新说明</string>

    <!-- 按钮行 -->
    <string name="update_btn_download">立即更新</string>
    <string name="update_btn_later">以后再说</string>
    <string name="update_btn_ignore">忽略此版本</string>
    <string name="update_btn_cancel">取消下载</string>
    <string name="update_btn_install">立即安装</string>

    <!-- 状态行（下载中 / 失败 / 需要授权） -->
    <string name="update_downloading">正在下载 %1$d%%</string>
    <string name="update_downloading_unknown">正在下载…</string>
    <string name="update_install_hint">请在系统设置里允许本应用安装应用</string>
    <string name="update_failed_download">下载失败，可重试</string>
    <!-- 包已经下好，只是这台设备上没有能接 APK 的应用：让用户重试下载永远走不通 -->
    <string name="update_failed_install">没有可用的安装器，可手动安装</string>

    <!-- 更新内容超出一屏时的提示。与版权声明同一个理由：电视上没有滚动条，
         不说出来用户只会以为「就这些」 -->
    <!-- 焦点还在按钮行：唯一进得去正文的键是「上」 -->
    <string name="update_scroll_hint">↓ 内容没显示完，按「上」进正文，可上下翻看</string>
    <!-- 焦点已经在正文里：这时按「下」才真的滚动 -->
    <string name="update_scroll_hint_in_body">↓ 按「下」继续阅读</string>
</resources>
