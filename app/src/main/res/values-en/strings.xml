    <!-- ==================== Settings: playback section ==================== -->
    <string name="settings_playback_core">Player core</string>
    <string name="settings_playback_core_warning">Not available on this device; ExoPlayer is used instead</string>
    <string name="settings_playback_core_hint">ExoPlayer is well supported and ships with the system; IJK bundles ffmpeg software decoding, so it handles old titles and unusual codecs better. This is only the default: changes made on the player screen apply to the current title.</string>
    <string name="settings_playback_decoder">Decoding</string>
    <string name="settings_playback_decoder_hint">Hardware decoding saves power and keeps 4K smooth; software decoding is more compatible. Note: with the ExoPlayer core, software decoding can only pick the system software decoders, so it still falls back to hardware when none are present; only the IJK core has real bundled ffmpeg software decoding, which old titles and unusual codecs depend on. Changes made on the player screen apply to the current title.</string>
    <string name="settings_playback_default_speed">Default playback speed</string>
    <string name="settings_playback_default_speed_hint">Every playback starts at this speed; a speed changed on the player screen only affects the current episode.</string>
    <string name="settings_playback_skip_intro">Skip intro automatically</string>
    <string name="settings_playback_skip_intro_hint">Only applies to videos you have never played; an intro is never trimmed again once watched.</string>
    <string name="settings_playback_skip_outro">Skip outro automatically</string>
    <string name="settings_playback_skip_outro_hint">Plays the next episode right at the outro. When off, the episode is still marked as watched.</string>

